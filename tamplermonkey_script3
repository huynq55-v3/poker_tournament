// ==UserScript==
// @name         PokerStars Universal WebSocket Sniffer & Silent Auto-Bot (v2.0)
// @namespace    http://tampermonkey.net/
// @version      2.0
// @description  Bắt trọn 100% gói tin 2 chiều & Tự động click/nhập chip ngầm trong tab PokerStars Web (AngularJS DOM Auto-Player)
// @match        *://*.pokerstars.com/*
// @match        *://*.pokerstars.net/*
// @match        *://*.pokerstars.eu/*
// @match        *://*.pokerstars.uk/*
// @match        *://*.pokerstars.bet/*
