// ==UserScript==
// @name         PokerNow to Localhost Forwarder (Stable v8.7 Silent React Bot)
// @namespace    http://tampermonkey.net/
// @version      8.7
// @description  Bắt trọn 100% gói tin gửi về receiver.rs & Tự chơi ngầm 100% trong tab (React DOM Clicker - Không chiếm chuột, không chiếm phím)
// @match        *://pokernow.com/games/*
// @match        *://www.pokernow.com/games/*
// @match        *://pokernow.club/games/*
// @match        *://*.pokernow.club/games/*
// @run-at       document-start
// @grant        unsafeWindow
// @grant        GM_xmlhttpRequest
// @connect      127.0.0.1
// @connect      localhost
// ==/UserScript==

(function() {
    'use strict';

    if (!window.location.href.includes('/games/')) {
        return;
    }

    console.log("⚡ [Tampermonkey v8.7] Silent React In-Page Bot đã kích hoạt!");

    // =========================================================================
    // 🥷 CÁC HÀM THỰC THI HÀNH ĐỘNG NGẦM TRONG TAB (ZERO MOUSE & KEYBOARD HIJACKING)
    // =========================================================================

    function pressKeyInPage(keyChar) {
        const codeMap = {
            'f': { key: 'f', code: 'KeyF', keyCode: 70 },
            'k': { key: 'k', code: 'KeyK', keyCode: 75 },
            'c': { key: 'c', code: 'KeyC', keyCode: 67 },
            'r': { key: 'r', code: 'KeyR', keyCode: 82 },
            'Enter': { key: 'Enter', code: 'Enter', keyCode: 13 }
        };
        const info = codeMap[keyChar];
        if (!info) return;

        const target = document.activeElement || document.body || window;
        const down = new KeyboardEvent('keydown', {
            key: info.key,
            code: info.code,
            keyCode: info.keyCode,
            which: info.keyCode,
            bubbles: true,
            cancelable: true
        });
        const up = new KeyboardEvent('keyup', {
            key: info.key,
            code: info.code,
            keyCode: info.keyCode,
            which: info.keyCode,
            bubbles: true,
            cancelable: true
        });

        window.dispatchEvent(down);
        document.dispatchEvent(down);
        target.dispatchEvent(down);
        window.dispatchEvent(up);
        document.dispatchEvent(up);
        target.dispatchEvent(up);
    }

    function clickElement(el) {
        if (!el) return false;
        try {
            el.focus();
            ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click'].forEach(evtName => {
                try {
                    const ev = new MouseEvent(evtName, {
                        bubbles: true,
                        cancelable: true
                    });
                    el.dispatchEvent(ev);
                } catch (err) {}
            });
            if (typeof el.click === 'function') {
                el.click();
            }
            return true;
        } catch (e) {
            try {
                el.click();
                return true;
            } catch (e2) {
                console.error("❌ [SILENT BOT] Lỗi click nút:", e2);
                return false;
            }
        }
    }

    function pressEnterOn(target) {
        const el = target || document.activeElement || document.body;
        try { el.focus(); } catch(e) {}
        const eventParams = {
            key: 'Enter',
            code: 'Enter',
            keyCode: 13,
            which: 13,
            charCode: 13,
            bubbles: true,
            cancelable: true
        };
        el.dispatchEvent(new KeyboardEvent('keydown', eventParams));
        el.dispatchEvent(new KeyboardEvent('keypress', eventParams));
        el.dispatchEvent(new KeyboardEvent('keyup', eventParams));
        document.dispatchEvent(new KeyboardEvent('keydown', eventParams));
        window.dispatchEvent(new KeyboardEvent('keydown', eventParams));
    }

    function getElementLabel(el) {
        if (!el) return '';
        return ((el.value || el.textContent || el.innerText || '') + '').trim().toLowerCase();
    }

    function findBetInput() {
        // Selector chính xác 100% của PokerNow: <input type="text" class="value" pattern="[0-9]*" inputmode="numeric">
        let el = document.querySelector('input.value[inputmode="numeric"], input.value, input[inputmode="numeric"]');
        if (el && el.offsetParent !== null) return el;

        // Dự phòng quét toàn bộ
        const allInputs = Array.from(document.querySelectorAll('input'));
        for (const input of allInputs) {
            if (input.type === 'hidden' || input.type === 'checkbox' || input.type === 'radio' || input.type === 'submit') continue;
            const cls = (input.className || '').toLowerCase();
            const placeholder = (input.placeholder || '').toLowerCase();
            if (cls.includes('chat') || placeholder.includes('chat') || placeholder.includes('message')) continue;
            if (input.offsetParent !== null) return input;
        }
        return null;
    }

    // Gán giá trị cược tương thích 100% với React.js (bypass React Synthetic Event wrapper)
    function setReactInputValue(input, val) {
        if (!input) return false;
        try {
            input.focus();
            const strVal = String(val);
            const proto = (typeof unsafeWindow !== 'undefined' && unsafeWindow.HTMLInputElement)
                ? unsafeWindow.HTMLInputElement.prototype
                : window.HTMLInputElement.prototype;
            const nativeInputValueSetter = Object.getOwnPropertyDescriptor(proto, 'value')?.set
                || Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value')?.set;
            if (nativeInputValueSetter) {
                nativeInputValueSetter.call(input, strVal);
            } else {
                input.value = strVal;
            }
            if (input._valueTracker) {
                input._valueTracker.setValue("");
            }
            input.dispatchEvent(new Event('input', { bubbles: true }));
            input.dispatchEvent(new Event('change', { bubbles: true }));
            return true;
        } catch (e) {
            try {
                input.value = String(val);
                input.dispatchEvent(new Event('input', { bubbles: true }));
                input.dispatchEvent(new Event('change', { bubbles: true }));
                return true;
            } catch (e2) {
                console.error("❌ [SILENT BOT] Lỗi set input React:", e2);
                return false;
            }
        }
    }

    function findActionButton(type) {
        // PokerNow dùng thẻ <input type="submit" class="button-1 action-button ..."> và <button>
        const allButtons = Array.from(document.querySelectorAll(
            'input[type="submit"].action-button, input[type="submit"], input[type="button"], button, .action-button, a.button, div[role="button"]'
        ));
        const visibleButtons = allButtons.filter(b => b.offsetParent !== null && !b.disabled);

        if (type === 'fold') {
            return visibleButtons.find(b => {
                const txt = getElementLabel(b);
                const cls = (b.className || '').toLowerCase();
                return txt === 'fold' || cls.includes('fold') || txt.includes('fold');
            });
        }

        if (type === 'check') {
            return visibleButtons.find(b => {
                const txt = getElementLabel(b);
                const cls = (b.className || '').toLowerCase();
                return txt === 'check' || cls.includes('check');
            });
        }

        if (type === 'call') {
            return visibleButtons.find(b => {
                const txt = getElementLabel(b);
                const cls = (b.className || '').toLowerCase();
                return txt.startsWith('call') || cls.includes('call') || txt.includes('call');
            });
        }

        if (type === 'all_in') {
            return visibleButtons.find(b => {
                const txt = getElementLabel(b);
                const cls = (b.className || '').toLowerCase();
                return txt.includes('all in') || txt.includes('all-in') || cls.includes('all-in') || cls.includes('allin') || txt === 'max';
            });
        }

        if (type === 'raise') {
            return visibleButtons.find(b => {
                const txt = getElementLabel(b);
                const cls = (b.className || '').toLowerCase();
                return cls.includes('bet') || cls.includes('raise') || txt.includes('raise') || txt.includes('bet');
            });
        }

        return null;
    }

    function findRaiseSubmitButton() {
        // Nút submit xanh của PokerNow: <input type="submit" class="button-1 action-button green highlighted bet" value="Raise">
        let btn = document.querySelector('input[type="submit"].action-button.bet, input.action-button.green.bet, input.action-button.bet, input[type="submit"].bet');
        if (btn && btn.offsetParent !== null && !btn.disabled) return btn;

        const allButtons = Array.from(document.querySelectorAll(
            'input[type="submit"].action-button, input[type="submit"], button, .action-button'
        ));
        return allButtons.find(b => {
            if (b.offsetParent === null || b.disabled) return false;
            const cls = (b.className || '').toLowerCase();
            const txt = getElementLabel(b);
            if (cls.includes('fold') || cls.includes('check') || txt.startsWith('call') || txt === 'fold' || txt === 'check') return false;
            return cls.includes('bet') || cls.includes('raise') || txt === 'raise' || txt === 'bet' || txt.startsWith('raise') || txt.startsWith('bet');
        });
    }

    function submitBet(input) {
        // 1. Click chính xác nút submit xanh của PokerNow
        const submitBtn = findRaiseSubmitButton() || findActionButton('raise');
        if (submitBtn) {
            console.log(`🔥 [SILENT BOT] Bấm nút submit cược: "${submitBtn.value || submitBtn.textContent}"`);
            clickElement(submitBtn);
        }

        // 2. Kích hoạt Enter trên input và submit form
        if (input) {
            pressEnterOn(input);
            if (input.form) {
                try {
                    input.form.requestSubmit(submitBtn || undefined);
                } catch (e) {
                    try { input.form.submit(); } catch(e2) {}
                }
            }
        }
    }

    // Quy trình thực hiện Tố / Cược / All-In theo đúng PokerNow:
    // 1. Kiểm tra / mở thanh cược (bấm 'r' hoặc click nút Raise)
    // 2. Điền số vào thẻ <input type="text" class="value" ...>
    // 3. Click nút submit <input type="submit" class="... bet" value="Raise"> và bấm Enter
    function performRaiseOrBet(amount, isAllIn = false) {
        console.log(`🎯 [SILENT BOT] Bắt đầu thao tác ${isAllIn ? 'ALL-IN' : 'RAISE'}: ${amount} chip`);

        let input = findBetInput();

        // Bước 1: Mở thanh cược nếu chưa mở
        if (!input) {
            pressKeyInPage('r');
            const raiseToggleBtn = findActionButton('raise');
            if (raiseToggleBtn) clickElement(raiseToggleBtn);
        }

        // Bước 2: Đợi thanh cược mở (50ms) rồi điền số và click submit
        setTimeout(() => {
            input = findBetInput();

            // Với All-In: Nếu có nút shortcut MAX / ALL IN thì click luôn
            if (isAllIn) {
                const maxBtn = Array.from(document.querySelectorAll('button, input[type="button"], input[type="submit"], a.button, div[role="button"]')).find(b => {
                    const txt = getElementLabel(b);
                    return b.offsetParent !== null && !b.disabled && (txt === 'max' || txt === 'all in' || txt === 'all-in');
                });
                if (maxBtn) {
                    console.log("🚀 [SILENT BOT] Click nút MAX / ALL-IN!");
                    clickElement(maxBtn);
                }
            }

            if (input) {
                input.focus();
                setReactInputValue(input, amount);
                console.log(`✍️ [SILENT BOT] Đã nhập ${amount} vào ô cược`);

                // Bước 3: Click nút Submit cược và Enter sau 40ms
                setTimeout(() => {
                    submitBet(input);
                    console.log("⚡ [SILENT BOT] Đã gửi lệnh cược thành công!");
                }, 40);
            } else {
                console.warn("⚠️ [SILENT BOT] Không thấy ô input, kích hoạt submit trực tiếp...");
                submitBet(null);
            }
        }, 50);
    }

    function executeSilentAction(cmd, attempt = 0) {
        if (!cmd || !cmd.action) return;
        const act = cmd.action.toLowerCase();
        console.log(`🥷 [SILENT BOT] Thực thi hành động ngầm: ${act.toUpperCase()} (Chip: ${cmd.amount || 0})`);

        let done = false;

        if (act === 'fold') {
            pressKeyInPage('f');
            const btn = findActionButton('fold');
            if (btn) {
                clickElement(btn);
                done = true;
                console.log("✅ [SILENT BOT] Đã click nút FOLD!");
            }
        } else if (act === 'check') {
            pressKeyInPage('k');
            const btn = findActionButton('check');
            if (btn) {
                clickElement(btn);
                done = true;
                console.log("✅ [SILENT BOT] Đã click nút CHECK!");
            }
        } else if (act === 'call') {
            pressKeyInPage('c');
            const btn = findActionButton('call');
            if (btn) {
                clickElement(btn);
                done = true;
                console.log("✅ [SILENT BOT] Đã click nút CALL!");
            }
        } else if (act === 'all_in') {
            const directAllIn = findActionButton('all_in');
            if (directAllIn && (getElementLabel(directAllIn).includes('all') || getElementLabel(directAllIn) === 'max')) {
                clickElement(directAllIn);
                console.log("✅ [SILENT BOT] Đã click nút ALL-IN trực tiếp!");
            }
            performRaiseOrBet(cmd.amount, true);
            done = true;
        } else if (act === 'raise') {
            performRaiseOrBet(cmd.amount, false);
            done = true;
        }

        // Nếu bàn chơi đang trong hoạt ảnh chưa kịp hiện nút, thử lại sau 120ms (tối đa 4 lần)
        if (!done && attempt < 4) {
            setTimeout(() => executeSilentAction(cmd, attempt + 1), 120);
        }
    }

    // =========================================================================
    // 🌐 GIAO TIẾP VỚI RUST BACKEND (:3000)
    // =========================================================================

    function sendToRust(payload) {
        GM_xmlhttpRequest({
            method: "POST",
            url: "http://127.0.0.1:3000/packet",
            headers: { "Content-Type": "application/json" },
            data: payload,
            timeout: 2000,
            onload: function(response) {
                try {
                    const data = JSON.parse(response.responseText);
                    if (data && data.bot_action) {
                        console.log("📥 [SILENT BOT] Nhận lệnh từ Rust:", data.bot_action);
                        executeSilentAction(data.bot_action);
                    }
                } catch(e) {
                    console.error("❌ Lỗi parse response từ Rust:", e);
                }
            },
            onerror: function(err) {
                // Server chưa bật hoặc lỗi kết nối
            },
            ontimeout: function() {}
        });
    }

    // Kiểm tra và gửi lại gói registered đã lưu trong sessionStorage nếu có (phòng khi Rust restart)
    try {
        const cachedReg = sessionStorage.getItem('pn_registered_packet');
        if (cachedReg) {
            setTimeout(() => {
                console.log("🔄 [SILENT BOT] Đồng bộ lại thông tin người chơi từ Cache...");
                sendToRust(cachedReg);
            }, 1000);
        }
    } catch(e) {}

    const win = (typeof unsafeWindow !== 'undefined') ? unsafeWindow : window;
    const NativeWebSocket = win.WebSocket;

    function CustomWebSocket(...args) {
        const ws = new NativeWebSocket(...args);

        ws.addEventListener('message', function(event) {
            const raw = event.data;
            if (typeof raw === 'string' && raw.length > 3 && raw.charCodeAt(0) === 52 && raw.charCodeAt(1) === 50) { // '42'
                const startIdx = raw.indexOf('[');
                if (startIdx !== -1 && raw.endsWith(']')) {
                    const packet = raw.substring(startIdx);

                    // Lưu cache gói registered
                    if (packet.includes('"registered"') || packet.includes('"currentPlayer"')) {
                        try { sessionStorage.setItem('pn_registered_packet', packet); } catch(e) {}
                    }

                    setTimeout(() => {
                        sendToRust(packet);
                    }, 0);
                }
            }
        }, false);

        return ws;
    }

    CustomWebSocket.prototype = NativeWebSocket.prototype;
    CustomWebSocket.CONNECTING = NativeWebSocket.CONNECTING;
    CustomWebSocket.OPEN = NativeWebSocket.OPEN;
    CustomWebSocket.CLOSING = NativeWebSocket.CLOSING;
    CustomWebSocket.CLOSED = NativeWebSocket.CLOSED;

    win.WebSocket = CustomWebSocket;
})();
